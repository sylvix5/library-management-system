{
  "info": {
    "name": "Library Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"admin123\",\n  \"name\": \"Head Librarian\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": { "raw": "http://localhost:3000/auth/register", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "http://localhost:3000/auth/login", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/genres", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["genres"] }
          }
        },
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science Fiction\"\n}"
            },
            "url": { "raw": "http://localhost:3000/genres", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["genres"] }
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/genres/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["genres", "1"] }
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sci-Fi & Fantasy\"\n}"
            },
            "url": { "raw": "http://localhost:3000/genres/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["genres", "1"] }
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": { "raw": "http://localhost:3000/genres/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["genres", "1"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (with Query Params)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/books?page=1&limit=10&search=python&genreId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "python" },
                { "key": "genreId", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Create Book (Guarded - Librarian)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer <YOUR_JWT_TOKEN_HERE>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mastering NestJS\",\n  \"author\": \"John Doe\",\n  \"isbn\": \"978-3-16-148410-0\",\n  \"totalCopies\": 5,\n  \"genreId\": 1\n}"
            },
            "url": { "raw": "http://localhost:3000/books", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["books"] }
          }
        }
      ]
    }
  ]
}